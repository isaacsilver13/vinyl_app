# Copy this file to .env and fill in your values.
# Generate your personal access token at: https://www.discogs.com/settings/developers

DISCOGS_TOKEN=your_personal_access_token_here
DISCOGS_USERNAME=your_discogs_username_here

# Vinyl API service. Use localhost for local development and the deployed API
# hostname in production.
VINYL_API_URL=http://127.0.0.1:8000
VINYL_API_KEY=

# Invite code required to create a new account via the web UI
REGISTRATION_CODE=your_invite_code_here

# -----------------------------
# SMTP settings for new-listing digest emails
# -----------------------------
# Replace the values below with your SMTP provider credentials.
# Recommended: use an app-specific password where supported (Gmail, Yahoo, etc.).
# Do NOT paste secrets into public chat.

# SMTP server hostname (e.g. smtp.sendgrid.net, smtp.gmail.com)
SMTP_HOST=smtp.example.com

# SMTP port (587 for STARTTLS, 465 for SSL/TLS)
SMTP_PORT=587

# SMTP auth username
SMTP_USERNAME=your_smtp_username

# SMTP auth password or app password
SMTP_PASSWORD=your_smtp_password

# Use TLS/STARTTLS (1 = enabled, 0 = disabled)
SMTP_USE_TLS=1

# From address used for alert emails
ALERT_FROM_EMAIL=alerts@yourdomain.com

# Optional: display name for the From field
ALERT_FROM_NAME=Vinyl Alerts

# Optional: enable SMTP debug logging (1 = enabled)
SMTP_DEBUG=0

# Example PowerShell export (do NOT paste your password here):
# $env:SMTP_HOST='smtp.example.com'; $env:SMTP_PORT='587'; $env:SMTP_USERNAME='user'; $env:SMTP_PASSWORD='pw'; $env:ALERT_FROM_EMAIL='alerts@yourdomain.com'; python vinyl/send_listing_alerts.py --user isilver13

# If deploying to Fly, add the corresponding secrets with:
# fly secrets set SMTP_HOST=... SMTP_PORT=... SMTP_USERNAME=... SMTP_PASSWORD=... ALERT_FROM_EMAIL=... SMTP_USE_TLS=1
